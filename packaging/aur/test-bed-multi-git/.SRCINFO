pkgbase = test-bed-multi-git
	pkgdesc = Mirror, control and test apps on up to five Android phones over Wi-Fi (GTK4)
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/Malverma/Android-Controller
	install = test-bed-multi.install
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	makedepends = cargo
	makedepends = git
	makedepends = clang
	depends = gtk4
	depends = libadwaita
	depends = glib2
	depends = android-tools
	depends = scrcpy
	depends = avahi
	depends = dbus
	depends = ffmpeg
	depends = gcc-libs
	depends = glibc
	optdepends = nss-mdns: resolve .local hostnames
	optdepends = pipewire-audio: play the focused phone's audio (pw-cat)
	optdepends = intel-media-driver: hardware video on Intel GPUs (Broadwell and newer)
	optdepends = libva-intel-driver: hardware decoding on older Intel GPUs
	optdepends = libva-mesa-driver: hardware decoding on AMD GPUs
	optdepends = libva-nvidia-driver: hardware decoding on NVIDIA GPUs
	provides = test-bed-multi
	conflicts = test-bed-multi
	conflicts = android-controller
	conflicts = android-controller-git
	replaces = android-controller-git
	options = !lto
	options = !debug
	source = test-bed-multi::git+https://github.com/Malverma/Android-Controller.git
	sha256sums = SKIP

pkgname = test-bed-multi-git
